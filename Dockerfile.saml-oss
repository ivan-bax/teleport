##
## Multi-stage Dockerfile for Teleport OSS with SAML support
##
## Builds the web UI from source (includes SAML management UI changes)
## and compiles the Go binaries from source.
##

# ----- Build web UI from source -----
FROM node:24.13.0-bookworm AS webui

# Install Rust and WASM toolchain
ENV RUST_VERSION=1.81.0
ENV WASM_BINDGEN_VERSION=0.2.99
ENV WASM_OPT_VERSION=0.116.1

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --default-toolchain ${RUST_VERSION} && \
    . "$HOME/.cargo/env" && \
    rustup target add wasm32-unknown-unknown && \
    cargo install wasm-bindgen-cli@${WASM_BINDGEN_VERSION} && \
    cargo install wasm-opt@${WASM_OPT_VERSION}

ENV PATH="/root/.cargo/bin:${PATH}"

# Enable pnpm via corepack
RUN corepack enable pnpm

WORKDIR /src

# Copy package files first for dependency caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/packages/teleport/package.json web/packages/teleport/
COPY web/packages/design/package.json web/packages/design/
COPY web/packages/shared/package.json web/packages/shared/
COPY web/packages/build/package.json web/packages/build/

# Install JS dependencies
RUN pnpm install --frozen-lockfile

# Copy web source and Rust/WASM source
COPY web/ web/
COPY Cargo.toml Cargo.lock ./
COPY lib/srv/desktop/rdp/rdpclient/ lib/srv/desktop/rdp/rdpclient/

# Build WASM module
RUN pnpm build-wasm

# Build web UI (OSS) — source already has SAML connector changes
RUN pnpm build-ui-oss

# ----- Build Go binaries -----
FROM golang:1.25-bookworm AS builder

WORKDIR /src

# Copy go module files first for caching
COPY go.mod go.sum ./
COPY api/go.mod api/go.sum ./api/
RUN go mod download

# Copy the full source tree
COPY . .

# Copy built web assets from webui stage
COPY --from=webui /src/webassets/teleport/ /src/webassets/teleport/

# Build teleport binaries
RUN CGO_ENABLED=1 go build -tags "webassets_embed" \
        -o /go/bin/teleport ./tool/teleport && \
    CGO_ENABLED=1 go build -tags "webassets_embed" \
        -o /go/bin/tctl ./tool/tctl && \
    CGO_ENABLED=1 go build \
        -o /go/bin/tsh ./tool/tsh && \
    CGO_ENABLED=1 go build \
        -o /go/bin/tbot ./tool/tbot

# ----- Runtime stage -----
FROM debian:12-slim

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates dumb-init libpam0g libaudit1 libcap-ng0 && \
    update-ca-certificates && \
    apt-get -y clean && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /go/bin/teleport /usr/local/bin/teleport
COPY --from=builder /go/bin/tctl /usr/local/bin/tctl
COPY --from=builder /go/bin/tsh /usr/local/bin/tsh
COPY --from=builder /go/bin/tbot /usr/local/bin/tbot

RUN mkdir -p /etc/teleport /var/lib/teleport

ENV TELEPORT_INSTALL_METHOD_DOCKERFILE=true

EXPOSE 3023 3024 3025 3080 443

STOPSIGNAL SIGQUIT

ENTRYPOINT ["/usr/bin/dumb-init", "teleport", "start", "-c", "/etc/teleport/teleport.yaml"]
